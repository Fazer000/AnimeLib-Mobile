<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/purple_alpha_25">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <selector
            android:enterFadeDuration="180"
            android:exitFadeDuration="180">
            <!-- Selected state (active voiceover) -->
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="@color/chip_selected_bg" />
                    <stroke android:width="0.5dp" android:color="@color/chip_selected_stroke" />
                </shape>
            </item>
            <!-- Normal / Unselected state -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
