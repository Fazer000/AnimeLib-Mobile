<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AnimeLIB" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Custom Colors -->
        <item name="primaryColor">@color/lt_primary_color</item>
        <item name="secondaryColor">@color/lt_secondary_color</item>
        <item name="blueColor">@color/lt_blue_color</item>
        <item name="alphaPrimaryColor">@color/lt_alpha_primary_color</item>

        <item name="statusBarColor">@color/lt_header_color</item>

        <item name="borderColor">@color/lt_border_color</item>
        <item name="alphaBorderColor">@color/lt_alpha_border_color</item>

        <item name="lineColor">@color/lt_line_color</item>

        <item name="primaryTextColor">@color/app_text_primary</item>
        <item name="secondaryTextColor">@color/app_text_secondary</item>
        <item name="accentTextColor">@color/app_text_secondary</item>
        <item name="brandButtonTextColor">@color/app_text_brand_button</item>
        <item name="accentBlueTextColor">@color/app_text_accent_blue</item>

        <item name="rvItemBackground">@color/lt_player_item_background</item>
        <item name="cardBackgroundColor">@color/lt_card_background</item>
        <item name="bookmarkCardBackground">@color/white_color</item>
        <item name="cardElevationColor">@color/lt_card_elevation</item>
        <item name="ratingStarColor">@color/lt_rating_star</item>
        <item name="playerItemBackground">@color/lt_player_item_background</item>
        <item name="relatedPanelBackground">@color/lt_related_panel_background</item>
        <item name="relatedTitleColor">@color/lt_related_title_color</item>
        <item name="relatedSubtitleColor">@color/lt_related_subtitle_color</item>

        <!-- System Color -->
        <item name="colorPrimary">@color/lt_primary_color</item>
        <item name="colorPrimaryVariant">@color/lt_alpha_primary_color</item>
        <item name="colorOnPrimary">@color/lt_secondary_color</item>
        <item name="colorSecondary">@color/white_color</item>

        <item name="android:windowBackground">@color/lt_header_color</item>
        <item name="android:navigationBarColor">@color/lt_primary_color</item>

        <item name="android:iconTint">@color/lt_primary_color</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/lt_header_color</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Global font family -->
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="fontFamily">@font/open_sans</item>
        <item name="android:textColor">@color/lt_primary_text_color</item>

        <item name="logoDrawable">@drawable/ic_logo_non_back_light</item>
        <item name="materialSwitchStyle">@style/Widget.AnimeLIB.MaterialSwitch</item>
        <item name="sliderStyle">@style/Widget.AnimeLIB.Slider</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.AnimeLIB.BottomSheetDialog</item>

<!--        <item name="android:fitsSystemWindows">true</item>-->
    </style>

    <style name="SplashScreenTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lt_header_color</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/animelib_logo_light</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item> <!-- Цвет круга behind иконки -->
        <item name="postSplashScreenTheme">@style/Theme.AnimeLIB</item>
        <item name="android:statusBarColor">@color/lt_header_color</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SplashScreenTheme.WebView" parent="SplashScreenTheme">
        <item name="postSplashScreenTheme">@style/Theme.AnimeLIB.WebView</item>
    </style>

    <style name="Theme.AnimeLIB.WebView" parent="Theme.AnimeLIB">
        <item name="statusBarColor">@color/lt_webview_status_bar_color</item>
        <item name="android:statusBarColor">@color/lt_webview_status_bar_color</item>
        <item name="android:windowBackground">@color/lt_webview_status_bar_color</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AnimeLIB.HeaderBar" parent="Theme.AnimeLIB">
        <item name="statusBarColor">@color/toolbar_header_bg</item>
        <item name="android:statusBarColor">@color/toolbar_header_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="CustomSpinnerShapeAppearance" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30dp</item>
        <item name="android:textColor">@color/lt_primary_text_color</item>
    </style>

    <style name="SearchItemCoverShape" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">14dp</item>
        <item name="cornerSizeBottomLeft">14dp</item>
        <item name="cornerSizeTopRight">14dp</item>
        <item name="cornerSizeBottomRight">14dp</item>
    </style>

    <!-- Основная тема для BottomSheetDialog -->
    <style name="ThemeOverlay.AnimeLIB.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="primaryTextColor">@color/app_text_primary</item>
        <item name="secondaryTextColor">@color/app_text_secondary</item>
        <item name="accentTextColor">@color/app_text_secondary</item>
        <item name="brandButtonTextColor">@color/app_text_brand_button</item>
        <item name="accentBlueTextColor">@color/app_text_accent_blue</item>
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
    </style>

    <!-- Основная тема для AlertDialog -->
    <style name="MaterialAlertDialog.AnimeLIB" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@color/lt_primary_color</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>

        <!-- Цвета текста -->
        <item name="android:textColorPrimary">@color/lt_primary_text_color</item>
        <item name="android:textColorSecondary">@color/lt_accent_text_color</item>

        <!-- Радиус скругления -->
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Video player theme - always fullscreen, landscape -->
    <style name="Theme.AnimeLIB.VideoPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/black_color</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowBackground">@color/black_color</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <!-- Ensure landscape orientation -->
        <item name="android:screenOrientation">landscape</item>
        <!-- Global font family -->
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="fontFamily">@font/open_sans</item>
        
        <!-- Custom Colors -->
        <item name="primaryColor">@color/lt_primary_color</item>
        <item name="secondaryColor">@color/lt_secondary_color</item>
        <item name="blueColor">@color/lt_blue_color</item>
        <item name="alphaPrimaryColor">@color/lt_alpha_primary_color</item>
        <item name="borderColor">@color/lt_border_color</item>
        <item name="alphaBorderColor">@color/lt_alpha_border_color</item>
        <item name="lineColor">@color/lt_line_color</item>
        <item name="primaryTextColor">@color/dt_primary_text_color</item>
        <item name="secondaryTextColor">@color/dt_secondary_text_color</item>
        <item name="accentTextColor">@color/dt_accent_text_color</item>
        <item name="brandButtonTextColor">@color/app_text_brand_button</item>
        <item name="accentBlueTextColor">#79A5D8</item>
        <item name="cardBackgroundColor">@color/lt_card_background</item>
        <item name="cardElevationColor">@color/lt_card_elevation</item>
        <item name="ratingStarColor">@color/lt_rating_star</item>
        <item name="playerItemBackground">@color/lt_player_item_background</item>
        <item name="relatedPanelBackground">@color/lt_related_panel_background</item>
        <item name="relatedTitleColor">@color/lt_related_title_color</item>
        <item name="relatedSubtitleColor">@color/lt_related_subtitle_color</item>
        <item name="materialSwitchStyle">@style/Widget.AnimeLIB.MaterialSwitch</item>
        <item name="sliderStyle">@style/Widget.AnimeLIB.Slider</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.AnimeLIB.BottomSheetDialog</item>
    </style>

    <!-- Custom Style for Material Slider -->
    <style name="Widget.AnimeLIB.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">14dp</item>
        <item name="trackCornerRadius">7dp</item>
        <item name="thumbColor">@color/purple_primary</item>
        <item name="trackColorActive">@color/purple_primary</item>
        <item name="trackColorInactive">@color/purple_alpha_25</item>
        <item name="haloColor">@color/purple_alpha_10</item>
        <item name="haloRadius">12dp</item>
        <item name="labelBehavior">gone</item>
    </style>

    <!-- Custom Style for MaterialSwitch using brand purple -->
    <style name="Widget.AnimeLIB.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="thumbTint">@color/switch_thumb_tint</item>
    </style>

    <style name="SpinnerTextStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/lt_primary_text_color</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Кастомный стиль для спиннера -->
    <style name="CustomProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">?attr/secondaryColor</item>
        <item name="trackColor">@android:color/transparent</item>
        <item name="trackThickness">4dp</item>
        <item name="indicatorSize">48dp</item>
    </style>

    <!-- Стиль для текста табов поиска -->
    <style name="SearchTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Standardized Button Styles -->
    <style name="Widget.AnimeLIB.Button" parent="Widget.Material3.Button">
        <item name="android:height">@dimen/button_height_standard</item>
        <item name="android:fontFamily">@font/open_sans_semibold</item>
        <item name="android:textSize">@dimen/button_text_size_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="android:textColor">@color/white_color</item>
        <item name="iconTint">@color/white_color</item>
        <item name="iconSize">@dimen/button_icon_size</item>
        <item name="iconPadding">@dimen/button_icon_padding</item>
    </style>

    <style name="Widget.AnimeLIB.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:height">@dimen/button_height_standard</item>
        <item name="android:fontFamily">@font/open_sans_semibold</item>
        <item name="android:textSize">@dimen/button_text_size_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/bs_divider_color</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="android:textColor">@color/primary_text_color</item>
        <item name="iconSize">@dimen/button_icon_size</item>
        <item name="iconPadding">@dimen/button_icon_padding</item>
    </style>

    <style name="Widget.AnimeLIB.Button.Danger" parent="Widget.AnimeLIB.Button">
        <item name="backgroundTint">@color/dialog_danger_bg</item>
        <item name="android:textColor">@color/dialog_danger_text</item>
    </style>

    <style name="Widget.AnimeLIB.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/open_sans_semibold</item>
        <item name="android:textSize">@dimen/button_text_size_standard</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textColor">@color/primary_text_color</item>
    </style>
</resources>