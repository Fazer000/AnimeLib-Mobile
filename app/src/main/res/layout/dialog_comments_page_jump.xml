<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ignore_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Перейти к странице"
            android:textColor="@color/primary_text_color"
            android:textSize="17sp"
            android:fontFamily="@font/open_sans_bold" />

        <ImageButton
            android:id="@+id/btnClosePageDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/button_close_background"
            android:contentDescription="Закрыть"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/accent_text_color" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPageDialogHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Введите номер страницы:"
        android:textColor="@color/accent_text_color"
        android:textSize="13sp"
        android:fontFamily="@font/open_sans"
        android:layout_marginBottom="12dp" />

    <!-- Number Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_ignore_input"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="20dp">

        <EditText
            android:id="@+id/etPageNumber"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="center"
            android:hint="1"
            android:inputType="number"
            android:maxLength="4"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/primary_text_color"
            android:textColorHint="@color/accent_text_color"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPageJump"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:text="Отмена"
            android:textColor="@color/accent_text_color"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans_bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPageJump"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="@color/purple_primary"
            android:text="Перейти"
            android:textColor="@color/white_color"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans_bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
