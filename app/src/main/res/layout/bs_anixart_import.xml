<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bs_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Bottom sheet handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Header: Title and Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvImportTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/anixart_import_title"
                android:textColor="@color/dialog_text_title"
                android:textSize="18sp"
                android:fontFamily="@font/open_sans_bold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvImportSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/anixart_import_subtitle"
                android:textColor="@color/dialog_text_muted"
                android:textSize="12sp"
                android:fontFamily="@font/open_sans" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseImport"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/dialog_icon_close"
            android:contentDescription="Закрыть"
            android:padding="4dp" />
    </LinearLayout>

    <!-- File Selection Box -->
    <LinearLayout
        android:id="@+id/btnSelectFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_input_box"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_file_upload"
            app:tint="@color/purple_primary"
            android:contentDescription="Файл" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSelectedFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/anixart_import_select_file"
                android:textColor="@color/dialog_text_title"
                android:textSize="14sp"
                android:fontFamily="@font/open_sans_semibold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvSelectedFileInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/anixart_import_status_ready"
                android:textColor="@color/dialog_text_muted"
                android:textSize="12sp"
                android:fontFamily="@font/open_sans" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/dialog_text_muted"
            android:contentDescription="Выбрать" />
    </LinearLayout>

    <!-- Status / Stats Counter Bar -->
    <LinearLayout
        android:id="@+id/layoutImportStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStatSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Успешно: 0"
            android:textColor="#3cce7b"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans_semibold" />

        <TextView
            android:id="@+id/tvStatNotFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Не найдено: 0"
            android:textColor="#ff9b40"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans_semibold" />

        <TextView
            android:id="@+id/tvStatErrors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Ошибки: 0"
            android:textColor="#f3382a"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans_semibold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvImportProgressFraction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textColor="@color/dialog_text_muted"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans_bold" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/pbImportProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/bg_gesture_progress_bar"
        android:visibility="gone"
        android:max="100"
        android:progress="0" />

    <!-- Live Status / Log box -->
    <TextView
        android:id="@+id/tvImportStatusLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_empty_icon_bg"
        android:padding="10dp"
        android:text="Готов к импорту. Формат строк: 1 / &quot;Название&quot; / &quot;Англ Название&quot;"
        android:textColor="@color/dialog_text_body"
        android:textSize="12sp"
        android:fontFamily="@font/open_sans"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelOrStop"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_close"
            android:textColor="@color/dialog_cancel_text"
            android:fontFamily="@font/open_sans_semibold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartImport"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/anixart_import_start"
            android:textColor="@color/white_color"
            android:backgroundTint="@color/purple_primary"
            android:fontFamily="@font/open_sans_bold"
            android:enabled="false"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
