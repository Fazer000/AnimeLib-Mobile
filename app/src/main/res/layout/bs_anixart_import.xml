<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Bottom sheet drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Top header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvImportTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/anixart_import_title"
                    android:textSize="@dimen/bs_title_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color" />

                <TextView
                    android:id="@+id/tvImportSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/anixart_import_subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/accent_text_color"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseImport"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/button_close_background"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/accent_text_color"
                android:contentDescription="Close" />

        </LinearLayout>

        <!-- Divider line matching design -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/bs_divider_color"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <!-- Main Content Container with Horizontal Margins -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 1. File Selection Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Файл списка"
                android:textColor="@color/primary_text_color"
                android:textSize="14sp"
                android:fontFamily="@font/open_sans_bold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- File Selection Card -->
            <LinearLayout
                android:id="@+id/btnSelectFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_file_upload"
                    app:tint="@color/purple_primary"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSelectedFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/anixart_import_select_file"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <TextView
                        android:id="@+id/tvSelectedFileInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/anixart_import_status_ready"
                        android:textColor="@color/accent_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/accent_text_color"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 2. Import Progress Section -->
            <LinearLayout
                android:id="@+id/layoutImportStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/chip_unselected"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <!-- Overall Progress Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvOverallText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Прогресс импорта"
                        android:textSize="13sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/primary_text_color" />

                    <TextView
                        android:id="@+id/tvImportProgressFraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 0"
                        android:textSize="13sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/secondary_text_color" />
                </LinearLayout>

                <!-- M3 Linear Progress Indicator (как в activity_update) -->
                <com.example.animelib.ui.M3LinearProgressIndicator
                    android:id="@+id/m3ProgressIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:max="100"
                    android:progress="0"
                    app:m3TrackHeight="8dp"
                    app:m3GapSize="4dp"
                    app:m3StopDotSize="4dp"
                    app:m3ShowStopDot="true" />

                <!-- Counters Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStatSuccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Добавлено: 0"
                        android:textColor="#3cce7b"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_semibold" />

                    <TextView
                        android:id="@+id/tvStatSkipped"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Уже в списке: 0"
                        android:textColor="#2196f3"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_semibold" />

                    <TextView
                        android:id="@+id/tvStatNotFound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Не найдено: 0"
                        android:textColor="#ff9b40"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_semibold" />

                    <TextView
                        android:id="@+id/tvStatErrors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Ошибки: 0"
                        android:textColor="#f3382a"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>

            </LinearLayout>

            <!-- 3. Status Log Box -->
            <TextView
                android:id="@+id/tvImportStatusLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/chip_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="Готов к импорту. Формат строк: 1 / &quot;Название&quot; / &quot;Англ Название&quot;"
                android:textColor="@color/secondary_text_color"
                android:textSize="12sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- 4. Single Full-Width Action Button (Start / Stop) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionImport"
                style="@style/Widget.AnimeLIB.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_large"
                android:layout_marginTop="16dp"
                android:text="@string/anixart_import_start"
                android:textColor="@color/white_color"
                app:icon="@drawable/ic_file_upload"
                app:iconGravity="textStart"
                app:iconTint="@color/white_color"
                android:fontFamily="@font/open_sans_bold"
                android:enabled="false"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
