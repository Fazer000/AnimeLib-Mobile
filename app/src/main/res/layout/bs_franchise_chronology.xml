<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bs_background"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Header: Title and controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Хронология франшизы"
                android:textColor="@color/primary_text_color"
                android:textSize="18sp"
                android:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvFranchiseCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_sticky_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="0 элементов"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="@font/open_sans_bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseFranchise"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/accent_text_color" />
    </RelativeLayout>

    <!-- Control bar: Sort direction button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSortOrder"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Хронологически (сначала старые)"
            android:textColor="@color/purple_primary"
            android:textSize="12.5sp"
            android:fontFamily="@font/open_sans_bold"
            app:icon="@drawable/ic_sort_arrows"
            app:iconTint="@color/purple_primary"
            app:strokeColor="@color/purple_primary"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvShikimoriSourceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shikimori API"
            android:textColor="@color/secondary_text_color"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/chip_unselected_stroke" />

    <!-- RecyclerView for list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFranchiseList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:overScrollMode="never" />

        <!-- Loading indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/franchiseProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/purple_primary"
            app:indicatorSize="36dp"
            android:visibility="gone" />

        <!-- Empty / Error state -->
        <TextView
            android:id="@+id/tvFranchiseError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Не удалось загрузить хронологию"
            android:textColor="@color/secondary_text_color"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
