<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bsMapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_map_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- Bottom sheet drag header area -->
    <LinearLayout
        android:id="@+id/bsMapHeaderArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bottom sheet handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bottom_sheet_handle" />

        <!-- Header bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Интерактивная карта"
                    android:textColor="@color/primary_text_color"
                    android:textSize="18sp"
                    android:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:id="@+id/tvMapCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_sticky_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="0 частей"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:fontFamily="@font/open_sans_bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseMap"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/button_close_background"
                android:clipToOutline="true"
                android:contentDescription="Close"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/accent_text_color" />
        </RelativeLayout>

        <!-- Legend Bar for Connection Curve Colors -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_anime_info_stat_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="● Сиквел / Приквел"
                    android:textColor="#A855F7"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_anime_info_stat_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="● Основной сюжет"
                    android:textColor="#3B82F6"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_anime_info_stat_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="┈ Сайд-стори"
                    android:textColor="#06B6D4"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_anime_info_stat_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="● Рекап"
                    android:textColor="#F59E0B"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/open_sans_bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/chip_unselected_stroke" />

    </LinearLayout>

    <!-- Interactive Map Canvas Container -->
    <FrameLayout
        android:id="@+id/mapGraphContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bs_bg_color">

        <com.example.animelib.views.FranchiseMapGraphView
            android:id="@+id/franchiseGraphView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Loading Overlay across entire map area -->
        <FrameLayout
            android:id="@+id/mapLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/map_loading_overlay_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="32dp"
                android:background="@drawable/card_bg_rounded"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingVertical="18dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/mapLoadingProgress"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/purple_primary"
                    app:indicatorSize="40dp"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/tvMapLoadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/open_sans_bold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:maxWidth="240dp"
                    android:text="Загрузка тайтла…"
                    android:textAlignment="center"
                    android:textColor="@color/primary_text_color"
                    android:textSize="13.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Error / Retry Container -->
        <LinearLayout
            android:id="@+id/mapErrorContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_exclamation_mark"
                app:tint="@color/secondary_text_color"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvMapErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Не удалось загрузить карту"
                android:textColor="@color/primary_text_color"
                android:textSize="15sp"
                android:fontFamily="@font/open_sans_bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Проверьте соединение с интернетом"
                android:textColor="@color/secondary_text_color"
                android:textSize="13sp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryMapLoad"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Повторить"
                android:textColor="@color/purple_primary"
                android:textSize="13sp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/purple_primary"
                app:strokeColor="@color/purple_primary"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Pinned Watermark: Shikimori API (Frameless in Bottom-Left Corner) -->
        <LinearLayout
            android:id="@+id/shikimoriWatermarkContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_shikimori"
                app:tint="@color/purple_primary"
                android:contentDescription="Shikimori Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Shikimori API"
                android:textColor="@color/accent_text_color"
                android:textSize="10.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Floating Zoom Control Buttons (+ / - / %) in Bottom-Right Corner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/zoomControlsCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp"
            app:cardBackgroundColor="@color/card_bg_color"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/chip_unselected_stroke"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btnZoomOut"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Zoom Out"
                    android:padding="6dp"
                    android:src="@drawable/ic_zoom_out"
                    app:tint="@color/primary_text_color" />

                <TextView
                    android:id="@+id/tvZoomPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:text="75%"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_bold" />

                <ImageButton
                    android:id="@+id/btnZoomIn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Zoom In"
                    android:padding="6dp"
                    android:src="@drawable/ic_zoom_in"
                    app:tint="@color/primary_text_color" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>
