<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/commentsPanel"
    android:layout_width="360dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@android:color/transparent"
    android:elevation="16dp"
    android:orientation="horizontal">

    <!-- Drag Handle - слева вертикально -->
    <FrameLayout
        android:id="@+id/dragZone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/drag_handle" />
    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/bs_bg_color"
        android:elevation="20dp"
        app:cardCornerRadius="20dp">

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- Dropdown Sort Button (Старые / Новые) -->
                <LinearLayout
                    android:id="@+id/btnSortComments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_comment_header_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="false"
                    android:focusable="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_sort_arrows"
                        app:tint="@color/accent_text_color"
                        android:contentDescription="Sort" />

                    <TextView
                        android:id="@+id/tvSortComments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Новые"
                        android:textColor="@color/accent_text_color"
                        android:textSize="13sp"
                        android:fontFamily="@font/open_sans_bold" />
                </LinearLayout>

                <!-- Filter Settings Button (Настройки - скрыто) -->
                <LinearLayout
                    android:id="@+id/btnCommentSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_comment_header_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_tune_sliders"
                        app:tint="@color/accent_text_color"
                        android:contentDescription="Settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Настройки"
                        android:textColor="@color/accent_text_color"
                        android:textSize="13sp"
                        android:fontFamily="@font/open_sans_bold" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Rules Button (ПРАВИЛА) -->
                <TextView
                    android:id="@+id/btnCommentRules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rules_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="ПРАВИЛА"
                    android:textColor="@color/accent_text_color"
                    android:textSize="11sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:letterSpacing="0.06" />

                <!-- Close Panel Button -->
                <ImageButton
                    android:id="@+id/closeCommentsButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/button_close_background"
                    android:contentDescription="Close Comments"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    app:tint="@color/accent_text_color" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/commentsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/emptyCommentsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Комментариев пока нет"
                    android:textColor="?attr/accentTextColor"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/commentsErrorLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCommentsErrorText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ошибка загрузки комментариев"
                        android:textColor="?attr/accentTextColor"
                        android:textSize="14sp"
                        android:gravity="center" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetryComments"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Повторить"
                        android:textColor="@color/purple_primary"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_refresh"
                        app:iconTint="@color/purple_primary"
                        app:strokeColor="@color/purple_primary"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/commentsLoadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        app:indicatorColor="?attr/secondaryColor"
                        app:trackCornerRadius="8dp"
                        app:trackThickness="4dp" />
                </FrameLayout>
            </FrameLayout>

            <!-- Comment Input Container -->
            <LinearLayout
                android:id="@+id/commentInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="6dp"
                android:background="@drawable/bg_comment_input"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Reply Bar (Hidden by default) -->
                <LinearLayout
                    android:id="@+id/replyBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvReplyToText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/secondary_color"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:ellipsize="end"
                        android:singleLine="true" />

                    <ImageButton
                        android:id="@+id/btnCancelReply"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Cancel reply"
                        android:padding="2dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/accent_text_color" />
                </LinearLayout>

                <!-- Formatting Bar Row (above input) -->
                <LinearLayout
                    android:id="@+id/formattingBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/btnFormatBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" B "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Bold" />

                    <TextView
                        android:id="@+id/btnFormatItalic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" I "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textStyle="italic"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Italic" />

                    <TextView
                        android:id="@+id/btnFormatUnderline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" U "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Underline" />

                    <TextView
                        android:id="@+id/btnFormatStrike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" S "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Strikethrough" />

                    <TextView
                        android:id="@+id/btnFormatSpoiler"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" [!] "
                        android:textColor="@color/accent_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Spoiler" />

                    <TextView
                        android:id="@+id/btnFormatQuote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:gravity="center"
                        android:text=" ” "
                        android:textColor="@color/accent_text_color"
                        android:textSize="16sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Quote" />
                </LinearLayout>

                <!-- Input Field Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/commentInputField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Написать комментарий..."
                        android:textColorHint="@color/accent_text_color"
                        android:textColor="@color/primary_text_color"
                        android:textSize="14sp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="6dp"
                        android:maxLines="3"
                        android:inputType="textMultiLine"
                        android:imeOptions="flagNoExtractUi|flagNoFullscreen" />

                    <ImageButton
                        android:id="@+id/btnSendComment"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Send comment"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_send"
                        app:tint="@color/secondary_color" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
