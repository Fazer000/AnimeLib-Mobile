<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btnCloseSettings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                app:tint="@color/accent_text_color"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_close"
                android:scaleType="fitCenter"
                android:contentDescription="Закрыть"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Настройки комментариев"
                android:textColor="@color/primary_text_color"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="@dimen/bs_title_text_size"
                android:paddingVertical="8dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/bs_divider_color"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- GROUP 1: Плеер -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Плеер"
            android:textColor="@color/primary_text_color"
            android:textSize="14.5sp"
            android:fontFamily="@font/open_sans_bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="14dp">

            <!-- Disable comments in player switch option -->
            <LinearLayout
                android:id="@+id/cardDisableComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_m3_item_single"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_comments"
                    app:tint="@color/primary_text_color"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Комментарии"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Отключить комментарии в плеере"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/tvDisableCommentsSubtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Скрыть кнопку и панель комментариев в плеере"
                        android:textColor="@color/accent_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDisableComments"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    app:trackTint="@color/switch_track_tint"
                    app:thumbTint="@color/switch_thumb_tint"
                    android:checked="false"/>
            </LinearLayout>
        </LinearLayout>

        <!-- GROUP 2: Ответы на комментарии -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ответы на комментарии"
            android:textColor="@color/primary_text_color"
            android:textSize="14.5sp"
            android:fontFamily="@font/open_sans_bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_m3_item_single"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <!-- Header of answers section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_down_right_arrow"
                    app:tint="@color/primary_text_color"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Ответы"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Отображаемые ответы"
                    android:textColor="@color/primary_text_color"
                    android:textSize="15.5sp"
                    android:fontFamily="@font/open_sans_bold"/>

                <!-- Readout Badge -->
                <TextView
                    android:id="@+id/tvRepliesLimitValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_comment_header_button"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="3 ответа"
                    android:textColor="@color/purple_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/open_sans_bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvRepliesLimitSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="Остальные ответы скрыты под кнопкой «Показать ещё»"
                android:textColor="@color/accent_text_color"
                android:textSize="12sp"
                android:fontFamily="@font/open_sans"/>

            <!-- Preset chips row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/presetReply1"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:text="1"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/presetReply2"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:text="2"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/presetReply3"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_selected"
                    android:text="3"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/purple_primary"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/presetReply5"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:text="5"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/presetReply10"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:text="10"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/presetReplyUnlimited"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1.3"
                    android:gravity="center"
                    android:background="@drawable/chip_unselected"
                    android:text="Все ∞"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Material 3 Expressive Slider (Stepped, last division unlimited) -->
            <com.example.animelib.views.ExpressiveSlider
                android:id="@+id/sliderRepliesLimit"
                style="@style/Widget.AnimeLIB.Slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:valueFrom="1.0"
                android:valueTo="11.0"
                android:stepSize="1.0"
                app:labelBehavior="gone" />

            <!-- Labels below slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1"
                    android:textColor="@color/accent_text_color"
                    android:textSize="11sp"
                    android:fontFamily="@font/open_sans"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/accent_text_color"
                    android:textSize="11sp"
                    android:fontFamily="@font/open_sans"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/accent_text_color"
                    android:textSize="11sp"
                    android:fontFamily="@font/open_sans"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Неограниченно"
                    android:textColor="@color/accent_text_color"
                    android:textSize="11sp"
                    android:fontFamily="@font/open_sans"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
