<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMapNode"
    android:layout_width="180dp"
    android:layout_height="90dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg_color"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Poster Cover -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivMapCardCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image_placeholder"
                android:contentDescription="Cover" />

            <TextView
                android:id="@+id/tvMapCardCurrentBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#D9A855F7"
                android:gravity="center"
                android:paddingVertical="1.5dp"
                android:text="СМОТРИТЕ"
                android:textColor="@android:color/white"
                android:textSize="8.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Node info (Title type in blue at top, title name, kind/year) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMapCardRelation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_text_accent_blue"
                android:textSize="11sp"
                android:fontFamily="@font/open_sans_bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvMapCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text_color"
                android:textSize="12.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp" />

            <TextView
                android:id="@+id/tvMapCardKind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/accent_text_color"
                android:textSize="10.5sp"
                android:fontFamily="@font/open_sans"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
