<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/bs_theme_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                app:tint="@color/accent_text_color"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="fitCenter"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bs_title_theme"
                android:gravity="center_vertical"
                android:textColor="@color/primary_text_color"
                android:textStyle="bold"
                android:fontFamily="@font/open_sans_bold"
                android:paddingVertical="8dp"
                android:layout_marginStart="8dp"
                android:textSize="@dimen/bs_title_text_size"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="8dp">

            <!-- Auto Theme Option -->
            <LinearLayout
                android:id="@+id/themeAutoOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_m3_item_top"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_auto"
                    app:tint="@color/primary_text_color"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Auto theme"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Авто"
                    android:textColor="@color/primary_text_color"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="15.5sp"/>

                <FrameLayout
                    android:id="@+id/themeAutoPill"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/themeAutoUnselected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Light Theme Option -->
            <LinearLayout
                android:id="@+id/themeLightOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_m3_item_middle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_light"
                    app:tint="@color/primary_text_color"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Light theme"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Светлая"
                    android:textColor="@color/primary_text_color"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="15.5sp"/>

                <FrameLayout
                    android:id="@+id/themeLightPill"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/themeLightUnselected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- Dark Theme Option -->
            <LinearLayout
                android:id="@+id/themeDarkOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:background="@drawable/bg_m3_item_bottom"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_night"
                    app:tint="@color/primary_text_color"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Dark theme"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Темная"
                    android:textColor="@color/primary_text_color"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="15.5sp"/>

                <FrameLayout
                    android:id="@+id/themeDarkPill"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/themeDarkUnselected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="visible"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
