<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Bottom sheet drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Top header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnBsBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/button_close_background"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_text_color"
                android:contentDescription="Назад"
                android:visibility="gone"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_title_download"
                    android:textSize="@dimen/bs_title_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Озвучка и качество"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans"
                    android:textColor="@color/accent_text_color"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBsGoToDownloads"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/button_close_background"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_download"
                app:tint="@color/purple_primary"
                android:contentDescription="Перейти к загрузкам"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnBsClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/button_close_background"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/accent_text_color"
                android:contentDescription="Закрыть" />

        </LinearLayout>

        <!-- ================= STEP 1: PLAYER, QUALITY & VOICEOVERS ================= -->
        <LinearLayout
            android:id="@+id/layoutStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:visibility="visible">

            <!-- 1. Player Section (compact connected chips) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_tv"
                    app:tint="@color/purple_primary"
                    android:contentDescription="@null"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_subtitle_download_player"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cgPlayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/chipPlayerAnimelib"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="72dp"
                    android:gravity="center"
                    android:text="AnimeLib"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/white_color"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/chipPlayerKodik"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="72dp"
                    android:gravity="center"
                    android:text="Kodik"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- 2. Quality Section (compact connected chips matching player chips) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_quality"
                    app:tint="@color/purple_primary"
                    android:contentDescription="@null"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_subtitle_download_quality"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/cgQualities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipQ2160"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="64dp"
                        android:gravity="center"
                        android:text="2160p"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/primary_text_color"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/chipQ1080"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="64dp"
                        android:gravity="center"
                        android:text="1080p"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/white_color"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/chipQ720"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="64dp"
                        android:gravity="center"
                        android:text="720p"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/primary_text_color"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/chipQ480"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="64dp"
                        android:gravity="center"
                        android:text="480p"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/primary_text_color"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/chipQ360"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="64dp"
                        android:gravity="center"
                        android:text="360p"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/primary_text_color"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- 3. Voiceover Section Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_voice"
                    app:tint="@color/purple_primary"
                    android:contentDescription="@null"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_subtitle_download_voiceovers"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVoiceovers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextStep"
                style="@style/Widget.AnimeLIB.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Далее"
                android:textSize="14.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:textColor="@color/white_color"
                app:backgroundTint="@color/purple_primary"
                app:rippleColor="#38FFFFFF"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconGravity="textEnd"
                app:iconTint="@color/white_color" />

        </LinearLayout>

        <!-- ================= STEP 2: EPISODES SELECTION ================= -->
        <LinearLayout
            android:id="@+id/layoutStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Selection Controls Block (frameless, player-styled action buttons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <!-- Counter Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Выбрано серий"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/primary_text_color" />

                    <ProgressBar
                        android:id="@+id/pbLoading"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:indeterminateTint="@color/purple_primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvSelectedCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 из 0"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/purple_primary"
                        android:background="@drawable/bg_m3_tonal_pill_purple"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />

                </LinearLayout>

                <!-- Quick Selection Actions -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="16dp"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSelectAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="Выбрать все"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/open_sans_semibold"
                            android:textColor="@color/primary_text_color"
                            android:background="@drawable/bg_portrait_block_button"
                            android:paddingHorizontal="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/btnDeselectAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="Снять все"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/open_sans_semibold"
                            android:textColor="@color/primary_text_color"
                            android:background="@drawable/bg_portrait_block_button"
                            android:paddingHorizontal="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/btnInvertSelection"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="Инвертировать"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/open_sans_semibold"
                            android:textColor="@color/primary_text_color"
                            android:background="@drawable/bg_portrait_block_button"
                            android:paddingHorizontal="14dp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Episodes Grid (M3 Expressive morphing tiles) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Download CTA Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownload"
                style="@style/Widget.AnimeLIB.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_download"
                android:textSize="14.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:textColor="@color/white_color"
                app:backgroundTint="@color/purple_primary"
                app:rippleColor="#38FFFFFF"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_download"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart"
                app:iconTint="@color/white_color" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
