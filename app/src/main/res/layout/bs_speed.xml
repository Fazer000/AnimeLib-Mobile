<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="@drawable/bottom_sheet_handle"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            app:tint="@color/accent_text_color"
            android:background="@drawable/button_close_background"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="fitCenter"
            android:contentDescription="Назад"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bs_title_speed"
            android:textColor="@color/primary_text_color"
            android:textStyle="bold"
            android:fontFamily="@font/open_sans_bold"
            android:textSize="@dimen/bs_title_text_size"
            android:paddingVertical="8dp"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/btnResetSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x (Сброс)"
            android:textColor="@color/purple_primary"
            android:textSize="12sp"
            android:fontFamily="@font/open_sans_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/btn_reset_speed_background"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/bs_divider_color"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"/>

    <!-- Compact Main Speed Adjustment Card (Frameless) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <!-- Stepper Decrease -->
            <TextView
                android:id="@+id/btnDecreaseSpeed"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="-0.1"
                android:textColor="@color/purple_primary"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans_bold"
                android:gravity="center"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Center Speed Readout -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/currentSpeedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_text_color"
                    android:text="1.0x"
                    android:textSize="24sp"
                    android:fontFamily="@font/open_sans_bold"/>

                <TextView
                    android:id="@+id/speedStateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Обычная скорость"
                    android:textColor="@color/accent_text_color"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- Stepper Increase -->
            <TextView
                android:id="@+id/btnIncreaseSpeed"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="+0.1"
                android:textColor="@color/purple_primary"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans_bold"
                android:gravity="center"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Material 3 Expressive Slider -->
        <com.example.animelib.views.ExpressiveSlider
            android:id="@+id/speedSlider"
            style="@style/Widget.AnimeLIB.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="16dp"
            android:valueFrom="0.25"
            android:valueTo="3.0"
            android:stepSize="0.05"
            app:labelBehavior="gone" />

    </LinearLayout>

    <!-- Preset Chips Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bs_subtitle_quick_select"
        android:textColor="@color/secondary_text_color"
        android:textSize="@dimen/bs_subtitle_text_size"
        android:textStyle="bold"
        android:fontFamily="@font/open_sans_bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"/>

    <!-- Row 1 Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:gravity="center">

        <TextView android:id="@+id/speed05x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_unselected"
            android:text="0.5x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

        <TextView android:id="@+id/speed075x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_unselected"
            android:text="0.75x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

        <TextView android:id="@+id/speed1x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_unselected"
            android:text="1.0x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

        <TextView android:id="@+id/speed125x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_unselected"
            android:text="1.25x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

        <TextView android:id="@+id/speed15x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/chip_unselected"
            android:text="1.5x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

    </LinearLayout>

    <!-- Row 2 Presets including Skip 10x -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:gravity="center">

        <TextView android:id="@+id/speed175x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_unselected"
            android:text="1.75x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

        <TextView android:id="@+id/speed2x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_unselected"
            android:text="2.0x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

        <TextView android:id="@+id/speed25x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_unselected"
            android:text="2.5x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

        <TextView android:id="@+id/speed3x"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_unselected"
            android:text="3.0x"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"/>

        <TextView android:id="@+id/speedSkip"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/chip_unselected"
            android:text="10.0x"
            android:textSize="12sp"
            android:fontFamily="@font/open_sans_bold"
            android:textColor="@color/purple_primary"/>

    </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
