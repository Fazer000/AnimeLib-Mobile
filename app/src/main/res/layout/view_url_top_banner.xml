<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/urlTopBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginHorizontal="14dp"
    android:layout_marginTop="10dp"
    android:visibility="gone"
    app:cardBackgroundColor="@color/bs_bg_color"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/bs_divider_color"
    app:strokeWidth="0.5dp">

    <!-- M3 Expressive Segmented Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Segment 1: CIS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBannerSelectCis"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/chip_selected_bg"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimeLIB.SegmentLeft"
            app:strokeColor="@color/purple_primary"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/bannerIconCis"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Выбрано"
                    android:src="@drawable/ic_check"
                    android:visibility="visible"
                    app:tint="@color/purple_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBannerCisTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_bold"
                        android:includeFontPadding="false"
                        android:text="СНГ"
                        android:textColor="@color/purple_primary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvBannerCisHost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/open_sans"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="v5.animelib.org"
                        android:textColor="@color/purple_primary"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Segment 2: Other Countries -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBannerSelectOther"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/chip_unselected_bg"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimeLIB.SegmentRight"
            app:strokeColor="@color/chip_unselected_stroke"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/bannerIconOther"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Выбрано"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="@color/purple_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBannerOtherTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_bold"
                        android:includeFontPadding="false"
                        android:text="Остальные"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvBannerOtherHost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/open_sans"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="animelib.org"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
