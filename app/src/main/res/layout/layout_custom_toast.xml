<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customToastContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="64dp"
    android:elevation="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="15dp"
    android:paddingBottom="9dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/customToastIconWrapper"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="11dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/customToastIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="Notification Icon"
            android:src="@drawable/ic_toast_warning" />
    </FrameLayout>

    <TextView
        android:id="@+id/customToastText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/app_text_primary"
        android:textSize="13.5sp"
        android:lineSpacingExtra="1.5dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:text="Сообщение" />

</LinearLayout>
