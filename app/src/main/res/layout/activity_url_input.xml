<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/urlInputRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bs_bg_color"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- M3 Tonal Brand Hero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        app:cardBackgroundColor="@color/chip_selected_bg"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            android:src="?attr/logoDrawable" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/open_sans_bold"
                        android:text="@string/url_input_title"
                        android:textColor="@color/primary_text_color"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/open_sans"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/url_input_subtitle"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Grouped M3 Expressive Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <!-- Option 1: CIS -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/chip_selected_bg"
                        app:cardElevation="0dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimeLIB.M3GroupTop"
                        app:strokeColor="@color/purple_primary"
                        app:strokeWidth="0.5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:id="@+id/iconContainerCis"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_m3_tonal_pill_purple">

                                    <ImageView
                                        android:id="@+id/ivIconCis"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@string/url_input_cis_title"
                                        android:src="@drawable/ic_link"
                                        app:tint="@color/purple_primary" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/open_sans_bold"
                                        android:text="@string/url_input_cis_title"
                                        android:textColor="@color/primary_text_color"
                                        android:textSize="16.5sp"
                                        android:textStyle="bold" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/tvCisBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="@font/open_sans_semibold"
                                        android:text="@string/url_input_cis_url"
                                        android:textColor="@color/purple_primary"
                                        android:textSize="12.5sp" />
                                </LinearLayout>

                                <FrameLayout
                                    android:id="@+id/selectedPillCis"
                                    android:layout_width="38dp"
                                    android:layout_height="26dp"
                                    android:layout_marginStart="12dp"
                                    android:background="@drawable/bg_m3_selected_pill"
                                    android:visibility="visible">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Выбрано"
                                        android:src="@drawable/ic_check"
                                        app:tint="#FFFFFF" />
                                </FrameLayout>

                                <View
                                    android:id="@+id/unselectedIndicatorCis"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="12dp"
                                    android:background="@drawable/bg_m3_unselected_circle"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- Domain List Box -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/bg_m3_url_inner_box"
                                android:orientation="vertical"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingVertical="3dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_site_animelib" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/open_sans_semibold"
                                        android:text="AnimeLib"
                                        android:textColor="@color/primary_text_color"
                                        android:textSize="12.5sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/open_sans"
                                        android:text="v5.animelib.org"
                                        android:textColor="@color/secondary_text_color"
                                        android:textSize="12.5sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingVertical="3dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_site_mangalib" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/open_sans_semibold"
                                        android:text="MangaLib"
                                        android:textColor="@color/primary_text_color"
                                        android:textSize="12.5sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/open_sans"
                                        android:text="mangalib.me"
                                        android:textColor="@color/secondary_text_color"
                                        android:textSize="12.5sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingVertical="3dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_site_ranobelib" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/open_sans_semibold"
                                        android:text="RanobeLib"
                                        android:textColor="@color/primary_text_color"
                                        android:textSize="12.5sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/open_sans"
                                        android:text="ranobelib.me"
                                        android:textColor="@color/secondary_text_color"
                                        android:textSize="12.5sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Option 2: Other Countries -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card_bg_color"
                        app:cardElevation="0dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimeLIB.M3GroupBottom"
                        app:strokeColor="@color/chip_unselected_stroke"
                        app:strokeWidth="0.5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:id="@+id/iconContainerOther"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_m3_url_inner_box">

                                    <ImageView
                                        android:id="@+id/ivIconOther"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@string/url_input_other_title"
                                        android:src="@drawable/ic_link"
                                        app:tint="@color/secondary_text_color" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/open_sans_bold"
                                        android:text="@string/url_input_other_title"
                                        android:textColor="@color/primary_text_color"
                                        android:textSize="16.5sp"
                                        android:textStyle="bold" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/tvOtherBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="@font/open_sans_semibold"
                                        android:text="@string/url_input_other_url"
                                        android:textColor="@color/secondary_text_color"
                                        android:textSize="12.5sp" />
                                </LinearLayout>

                                <FrameLayout
                                    android:id="@+id/selectedPillOther"
                                    android:layout_width="38dp"
                                    android:layout_height="26dp"
                                    android:layout_marginStart="12dp"
                                    android:background="@drawable/bg_m3_selected_pill"
                                    android:visibility="gone">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Выбрано"
                                        android:src="@drawable/ic_check"
                                        app:tint="#FFFFFF" />
                                </FrameLayout>

                                <View
                                    android:id="@+id/unselectedIndicatorOther"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="12dp"
                                    android:background="@drawable/bg_m3_unselected_circle"
                                    android:visibility="visible" />
                            </LinearLayout>

                            <!-- Domain List Box -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/bg_m3_url_inner_box"
                                android:orientation="vertical"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingVertical="3dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_site_animelib" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/open_sans_semibold"
                                        android:text="AnimeLib"
                                        android:textColor="@color/primary_text_color"
                                        android:textSize="12.5sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/open_sans"
                                        android:text="animelib.org"
                                        android:textColor="@color/secondary_text_color"
                                        android:textSize="12.5sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingVertical="3dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_site_mangalib" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/open_sans_semibold"
                                        android:text="MangaLib"
                                        android:textColor="@color/primary_text_color"
                                        android:textSize="12.5sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/open_sans"
                                        android:text="mangalib.org"
                                        android:textColor="@color/secondary_text_color"
                                        android:textSize="12.5sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingVertical="3dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_site_ranobelib" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/open_sans_semibold"
                                        android:text="RanobeLib"
                                        android:textColor="@color/primary_text_color"
                                        android:textSize="12.5sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/open_sans"
                                        android:text="ranobelib.org"
                                        android:textColor="@color/secondary_text_color"
                                        android:textSize="12.5sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky M3 Pill Action -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="@font/open_sans_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textColor="@color/white_color"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/purple_primary"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/white_color" />
    </FrameLayout>

</LinearLayout>
