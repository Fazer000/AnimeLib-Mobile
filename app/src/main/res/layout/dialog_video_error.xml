<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_ignore_dialog">

    <!-- Header with Icon, Title, and Close cross -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_ignore_danger"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_exclamation_mark"
                app:tint="@color/dialog_danger_text"
                android:contentDescription="Ошибка" />
        </FrameLayout>

        <TextView
            android:id="@+id/errorTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ошибка загрузки видео"
            android:textColor="@color/dialog_text_title"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/closeErrorCrossButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/dialog_icon_close"
            android:contentDescription="Закрыть"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Error message details -->
    <TextView
        android:id="@+id/errorMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Не удалось воспроизвести видео с выбранного источника."
        android:textColor="@color/dialog_text_body"
        android:textSize="14sp"
        android:fontFamily="@font/open_sans"
        android:lineSpacingExtra="2dp" />

    <!-- Current player & quality details -->
    <TextView
        android:id="@+id/errorPlayerDetailsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:text="Плеер: -"
        android:textColor="@color/dialog_text_muted"
        android:textSize="13sp"
        android:fontFamily="@font/open_sans"
        android:background="@drawable/bg_ignore_info_card"
        android:visibility="visible" />

    <!-- Full technical log area -->
    <ScrollView
        android:id="@+id/errorLogScrollView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ignore_info_card"
        android:padding="8dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/errorLogDetailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/app_text_secondary"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:text="Лог пуст" />
    </ScrollView>

    <!-- Action buttons: 1. Обновить (icon), 2. Скачанное (icon), 3. Лог (icon), 4. Выйти -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="42dp"
            android:layout_height="46dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/dialog_btn_neutral_text"
            android:backgroundTint="@color/dialog_btn_neutral_bg"
            app:cornerRadius="10dp"
            app:strokeWidth="0dp"
            android:contentDescription="Обновить"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToDownloadsButton"
            android:layout_width="42dp"
            android:layout_height="46dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/purple_primary"
            android:backgroundTint="@color/dialog_btn_neutral_bg"
            app:cornerRadius="10dp"
            app:strokeWidth="0dp"
            android:contentDescription="Скачанное"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportBugButton"
            android:layout_width="42dp"
            android:layout_height="46dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_bug_report"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/purple_primary"
            android:backgroundTint="@color/dialog_btn_neutral_bg"
            app:cornerRadius="10dp"
            app:strokeWidth="0dp"
            android:contentDescription="Сообщить об ошибке на GitHub"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyLogButton"
            android:layout_width="42dp"
            android:layout_height="46dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/dialog_btn_neutral_text"
            android:backgroundTint="@color/dialog_btn_neutral_bg"
            app:cornerRadius="10dp"
            app:strokeWidth="0dp"
            android:contentDescription="Скопировать лог"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exitButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Выйти"
            android:textColor="@color/dialog_danger_text"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold"
            android:backgroundTint="@color/dialog_danger_bg"
            app:strokeWidth="0dp"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
