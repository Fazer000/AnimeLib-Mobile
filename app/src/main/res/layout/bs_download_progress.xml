<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Bottom sheet drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Top header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivProgressHeaderIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_download"
                app:tint="@color/purple_primary"
                android:contentDescription="@null"
                android:layout_marginEnd="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProgressHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_title_download_progress"
                    android:textSize="@dimen/bs_title_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/primary_text_color" />

                <TextView
                    android:id="@+id/tvProgressHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Загрузка серий..."
                    android:textSize="12.5sp"
                    android:fontFamily="@font/open_sans"
                    android:textColor="@color/accent_text_color"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHeaderOpenDownloadSheet"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/button_close_background"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_download"
                app:tint="@color/purple_primary"
                android:contentDescription="Перейти к загрузкам"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnProgressClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/button_close_background"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/accent_text_color"
                android:contentDescription="Закрыть" />

        </LinearLayout>

        <!-- Overall Progress M3 Hero Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_m3_card_surface"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOverallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Обработано 0 из 0 серий"
                        android:textSize="14.5sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/primary_text_color" />

                    <TextView
                        android:id="@+id/tvOverallStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Загрузка в фоне"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textColor="@color/purple_primary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvOverallPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:gravity="center"
                    android:text="0%"
                    android:textSize="13.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/purple_primary"
                    android:background="@drawable/bg_m3_tonal_pill_purple"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="5dp"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <com.example.animelib.ui.M3LinearProgressIndicator
                android:id="@+id/pbOverall"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                app:m3TrackHeight="8dp"
                app:m3GapSize="4dp"
                app:m3StopDotSize="4dp"
                app:m3ShowStopDot="true" />

        </LinearLayout>

        <!-- Queue Tasks Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProgressTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="2dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Bottom Action Buttons (M3 Flat Tonal) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenDownloadSheet"
                style="@style/Widget.AnimeLIB.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Выбрать серии"
                android:textColor="@color/purple_primary"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans_bold"
                android:maxLines="1"
                app:backgroundTint="@color/popup_item_selected_bg"
                app:rippleColor="@color/purple_alpha_25"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/purple_primary"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseResumeDownload"
                style="@style/Widget.AnimeLIB.Button"
                android:layout_width="48dp"
                android:layout_height="@dimen/button_height_standard"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:layout_marginEnd="8dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:contentDescription="Пауза"
                android:visibility="gone"
                app:backgroundTint="@color/dialog_btn_neutral_bg"
                app:rippleColor="@color/dialog_ripple_color"
                app:icon="@drawable/ic_pause"
                app:iconTint="@color/dialog_btn_neutral_text"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopDownload"
                style="@style/Widget.AnimeLIB.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/button_height_standard"
                android:paddingHorizontal="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Закрыть"
                android:textColor="@color/dialog_btn_neutral_text"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans_bold"
                android:maxLines="1"
                app:backgroundTint="@color/dialog_btn_neutral_bg"
                app:rippleColor="@color/dialog_ripple_color"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
