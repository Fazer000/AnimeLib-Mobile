<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:letterSpacing="0.01"
                android:text="@string/bs_title_voiceovers"
                android:textColor="@color/primary_text_color"
                android:textSize="@dimen/bs_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVoiceoverSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Выберите плеер или озвучку"
                android:textColor="@color/accent_text_color"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDownloadFromMenu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_ripple_effect"
            android:contentDescription="Download Episodes"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download"
            android:visibility="gone"
            app:tint="@color/secondary_text_color" />

        <ImageButton
            android:id="@+id/closeMenuButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/button_close_background"
            android:contentDescription="Close Menu"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/accent_text_color" />

    </LinearLayout>

    <!-- Segmented Control Container for TabLayout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_segmented_control"
        android:padding="3dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/bg_segmented_tab_indicator"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@color/purple_primary"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="stretch"
            app:tabIndicatorHeight="38dp"
            app:tabMode="fixed"
            app:tabRippleColor="@null"
            app:tabBackground="@drawable/bg_segmented_tab_ripple"
            app:tabUnboundedRipple="false"
            app:tabSelectedTextColor="@color/white_color"
            app:tabTextColor="@color/primary_text_color" />
    </FrameLayout>

    <!-- Search & Filter Bar -->
    <LinearLayout
        android:id="@+id/voiceoverFilterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_comment_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Search Icon"
                android:src="@drawable/ic_search"
                app:tint="@color/accent_text_color" />

            <EditText
                android:id="@+id/etSearchVoiceovers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Поиск озвучки..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:textColor="@color/primary_text_color"
                android:textColorHint="@color/accent_text_color"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnClearVoiceoversSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear search"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/accent_text_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSortVoiceovers"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_comment_header_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Sort"
                android:src="@drawable/ic_sort_arrows"
                app:tint="@color/primary_text_color" />

            <TextView
                android:id="@+id/tvSortVoiceovers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/open_sans_semibold"
                android:text="По названию (А-Я)"
                android:textColor="@color/primary_text_color"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Line under filter bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/bs_divider_color" />

    <!-- Players List Container with loading overlay -->
    <com.example.animelib.ui.MaxHeightFrameLayout
        android:id="@+id/playersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Shadow overlay under tabs -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_tab_shadow"
            android:clickable="false"
            android:focusable="false" />

        <FrameLayout
            android:id="@+id/menuLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bs_bg_color"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/menuLoadingIndicator"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/purple_primary"
                app:trackCornerRadius="8dp"
                app:trackThickness="4dp" />
        </FrameLayout>
    </com.example.animelib.ui.MaxHeightFrameLayout>
</LinearLayout>
