<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_color"
    android:fitsSystemWindows="false">

    <!-- Loading Overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_color"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/white_color" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Загрузка видео..."
            android:textColor="@color/app_text_primary"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Ambient Light Container (behind main video layout, full screen) -->
    <FrameLayout
        android:id="@+id/ambientContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <!-- Live Real-Time Texture View Sampler (Zero-lag Ambilight) -->
        <ImageView
            android:id="@+id/ambientImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <!-- Secondary Ambient Player View (blurred edge glow fallback) -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/ambientPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:use_controller="false"
            app:surface_type="texture_view"
            app:resize_mode="zoom"
            app:show_buffering="never"
            app:shutter_background_color="@android:color/transparent" />

        <!-- Organic Vignette & Falloff Overlay for Ambient Light -->
        <com.example.animelib.ui.AmbientVignetteOverlayView
            android:id="@+id/ambientVignetteOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Main Video Layout (Holds Video Container and Portrait Bottom Space) -->
    <LinearLayout
        android:id="@+id/mainVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Video Player Container -->
        <com.example.animelib.ui.RoundedCornerFrameLayout
            android:id="@+id/playerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|start">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                app:shutter_background_color="@android:color/transparent"
                app:surface_type="texture_view"
                app:animation_enabled="false"
                app:controller_layout_id="@layout/custom_player_controller"
                app:repeat_toggle_modes="none"
                app:show_buffering="never"
                app:show_next_button="false"
                app:show_previous_button="false"
                app:show_shuffle_button="false"
                app:show_subtitle_button="false" />

            <!-- Standalone Buffering Indicator (Always visible when buffering, even when controls are hidden) -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/playerBufferingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/purple_primary"
                app:trackCornerRadius="8dp"
                app:trackThickness="4dp"
                app:indicatorSize="48dp"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false"
                android:elevation="30dp"
                android:translationZ="30dp" />

            <!-- Swipe seek preview -->
            <TextView
                android:id="@+id/seekPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="80dp"
                android:background="@drawable/video_time_background"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="+0 c"
                android:textColor="@color/player_item_inactive_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Hold-to-speed plaque -->
            <TextView
                android:id="@+id/holdSpeedToast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="80dp"
                android:background="@drawable/video_time_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="2x"
                android:textColor="@color/player_item_inactive_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Double tap skip indicator - Left (backward) -->
            <LinearLayout
                android:id="@+id/skipIndicatorLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="130dp"
                android:orientation="vertical"
                android:gravity="center"
                android:alpha="0"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/skipIconLeft"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_skip"
                    android:rotation="180"
                    android:alpha="0.9"
                    app:tint="@color/white_color" />

                <TextView
                    android:id="@+id/skipTextLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/video_time_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="-85 сек"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Double tap skip indicator - Right (forward) -->
            <LinearLayout
                android:id="@+id/skipIndicatorRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="130dp"
                android:orientation="vertical"
                android:gravity="center"
                android:alpha="0"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/skipIconRight"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_skip"
                    android:alpha="0.9"
                    app:tint="@color/white_color" />

                <TextView
                    android:id="@+id/skipTextRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/video_time_background"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="+85 сек"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Unified vertical gesture indicator plaque (Brightness & Volume) -->
            <LinearLayout
                android:id="@+id/gestureIndicatorPlaque"
                android:layout_width="160dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="80dp"
                android:background="@drawable/video_time_background"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/gestureIndicatorIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_brightness"
                    app:tint="@color/white_color" />

                <ProgressBar
                    android:id="@+id/gestureIndicatorProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/bg_gesture_progress_bar" />

                <TextView
                    android:id="@+id/gestureIndicatorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|start"
                    android:text="100%"
                    android:textColor="@color/player_item_inactive_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </com.example.animelib.ui.RoundedCornerFrameLayout>

        <!-- Container for Portrait Mode (below player) -->
        <FrameLayout
            android:id="@+id/portraitBottomContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bs_bg_color"
            android:visibility="gone">

            <include layout="@layout/layout_portrait_player_content" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnPortraitScrollToTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="Scroll to top"
                android:visibility="gone"
                app:fabSize="mini"
                app:backgroundTint="@color/purple_primary"
                app:tint="@color/white_color"
                app:srcCompat="@drawable/ic_arrow_up"
                app:elevation="6dp" />

        </FrameLayout>

    </LinearLayout>
    
    <!-- Anime Info Placeholder (показывается слева от панели озвучек когда не выбрана озвучка) -->
    <include
        android:id="@+id/animeInfoPlaceholder"
        layout="@layout/anime_info_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="360dp"
        android:visibility="gone" />

    <!-- Next Episode Overlay (показывается перед автовоспроизведением следующего эпизода) -->
    <include
        android:id="@+id/nextEpisodeOverlay"
        layout="@layout/next_episode_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <View
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dt_alpha_primary_color"
        android:clickable="true"
        android:visibility="gone" />

    <!-- Sliding Menu Panel -->
    <com.example.animelib.ui.DraggableSidePanel
        android:id="@+id/menuPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        
        <include layout="@layout/panel_voiceover_menu" />
        
    </com.example.animelib.ui.DraggableSidePanel>

    <!-- Comments Side Panel -->
    <com.example.animelib.ui.DraggableSidePanel
        android:id="@+id/commentsPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        
        <include layout="@layout/panel_comments" />
        
    </com.example.animelib.ui.DraggableSidePanel>

    <!-- Затемняющий overlay для связанных тайтлов -->
    <View
        android:id="@+id/relatedTitlesDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Related Titles Overlay (поверх всего, открывается сверху) -->
    <FrameLayout
        android:id="@+id/relatedTitlesOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <!-- Информация об аниме (ВЫШЕ заголовка) -->
            <LinearLayout
                android:id="@+id/relatedAnimeInfoContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:alpha="0">

                <!-- Обложка аниме (вертикальная) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="140dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="14dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">
                    
                    <ImageView
                        android:id="@+id/relatedAnimeCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Anime Cover" />
                        
                </androidx.cardview.widget.CardView>

                <!-- Информация справа от обложки -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="4dp">

                        <!-- Название аниме -->
                        <TextView
                            android:id="@+id/relatedAnimeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/app_text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:lineSpacingMultiplier="1.1" />

                        <!-- Английское название -->
                        <TextView
                            android:id="@+id/relatedAnimeEngTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="13sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:visibility="gone" />

                        <!-- Чипы с метаинформацией -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/relatedAnimeChipGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:chipSpacingHorizontal="6dp"
                            app:chipSpacingVertical="4dp"
                            app:singleLine="false">

                            <!-- Тип (ТВ Сериал, Фильм и т.д.) -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/relatedAnimeTypeChip"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/primary_text_color"
                                app:chipBackgroundColor="@color/chip_unselected_bg"
                                app:chipStrokeColor="@color/chip_unselected_stroke"
                                app:chipStrokeWidth="0.5dp"
                                app:chipMinHeight="28dp"
                                app:ensureMinTouchTargetSize="false" />

                            <!-- Статус (Онгоинг, Вышло и т.д.) -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/relatedAnimeStatusChip"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/primary_text_color"
                                app:chipBackgroundColor="@color/chip_unselected_bg"
                                app:chipStrokeColor="@color/chip_unselected_stroke"
                                app:chipStrokeWidth="0.5dp"
                                app:chipMinHeight="28dp"
                                app:ensureMinTouchTargetSize="false" />

                            <!-- Год выхода -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/relatedAnimeYearChip"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/primary_text_color"
                                app:chipBackgroundColor="@color/chip_unselected_bg"
                                app:chipStrokeColor="@color/chip_unselected_stroke"
                                app:chipStrokeWidth="0.5dp"
                                app:chipMinHeight="28dp"
                                app:ensureMinTouchTargetSize="false"
                                android:visibility="gone" />

                            <!-- Возрастной рейтинг -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/relatedAnimeAgeChip"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/primary_text_color"
                                app:chipBackgroundColor="@color/chip_unselected_bg"
                                app:chipStrokeColor="@color/chip_unselected_stroke"
                                app:chipStrokeWidth="0.5dp"
                                app:chipMinHeight="28dp"
                                app:ensureMinTouchTargetSize="false"
                                android:visibility="gone" />

                        </com.google.android.material.chip.ChipGroup>

                        <!-- Рейтинг -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_star" />

                            <TextView
                                android:id="@+id/relatedAnimeRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/relatedAnimeVotes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- Количество эпизодов -->
                        <TextView
                            android:id="@+id/relatedAnimeEpisodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Заголовок "Связанные тайтлы" -->
            <TextView
                android:id="@+id/relatedTitlesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:text="Связанные тайтлы"
                android:textColor="@color/app_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:alpha="0" />

            <!-- RecyclerView для связанных тайтлов -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedTitlesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:fadeScrollbars="true"/>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
