<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/bs_subtitles_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                app:tint="?attr/accentTextColor"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="fitCenter"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bs_title_subtitles"
                android:gravity="center_vertical"
                android:textColor="?attr/primaryTextColor"
                android:textStyle="bold"
                android:fontFamily="@font/open_sans_bold"
                android:layout_marginStart="12dp"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Toggle Switch Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:id="@+id/subtitlesEnableRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:background="@drawable/bg_m3_item_single"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Отображать субтитры"
                    android:textColor="?attr/primaryTextColor"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="15.5sp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/subtitlesEnableSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    app:trackTint="@color/switch_track_tint"
                    app:thumbTint="@color/switch_thumb_tint"
                    android:checked="true"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"
            android:text="@string/bs_subtitle_format_default"
            android:textColor="?attr/primaryTextColor"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/open_sans_bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Auto Option -->
            <LinearLayout
                android:id="@+id/subtitlesAutoOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_m3_item_top"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Автоматически"
                        android:textColor="?attr/primaryTextColor"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="15.5sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Предпочитать ASS, затем VTT"
                        android:textColor="?attr/accentTextColor"
                        android:textSize="12.5sp"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/pillAuto"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/unselectedAuto"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- ASS Option -->
            <LinearLayout
                android:id="@+id/subtitlesAssOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_m3_item_middle"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASS (Advanced SubStation Alpha)"
                        android:textColor="?attr/primaryTextColor"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="15.5sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Полный стиль и оформление аниме"
                        android:textColor="?attr/accentTextColor"
                        android:textSize="12.5sp"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/pillAss"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/unselectedAss"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="visible"/>
            </LinearLayout>

            <!-- VTT Option -->
            <LinearLayout
                android:id="@+id/subtitlesVttOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:background="@drawable/bg_m3_item_bottom"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WebVTT (VTT)"
                        android:textColor="?attr/primaryTextColor"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="15.5sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Стандартные текстовые субтитры"
                        android:textColor="?attr/accentTextColor"
                        android:textSize="12.5sp"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/pillVtt"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="Selected"/>
                </FrameLayout>

                <View
                    android:id="@+id/unselectedVtt"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_m3_unselected_circle"
                    android:visibility="visible"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Subtitle Style Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/bs_divider_color"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:text="@string/bs_subtitle_style_title"
            android:textColor="@color/secondary_text_color"
            android:textSize="@dimen/bs_subtitle_text_size"
            android:textStyle="bold"
            android:fontFamily="@font/open_sans_bold"/>

        <!-- Live Preview Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/card_bg_rounded">

            <TextView
                android:id="@+id/subtitlePreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/bs_subtitle_style_preview_text"
                android:textColor="@color/app_text_primary"
                android:textSize="18sp"
                android:fontFamily="@font/open_sans_bold"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Font Size Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bs_subtitle_style_size"
                android:textColor="@color/secondary_text_color"
                android:textSize="@dimen/bs_subtitle_text_size"
                android:fontFamily="@font/open_sans_semibold"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipSize14"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_size_14"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipSize16"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_size_16"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipSize18"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_selected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_size_18"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipSize22"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_size_22"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipSize26"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_size_26"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Text Color Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bs_subtitle_style_color"
                android:textColor="@color/secondary_text_color"
                android:textSize="@dimen/bs_subtitle_text_size"
                android:fontFamily="@font/open_sans_semibold"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipColorWhite"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_selected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_color_white"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipColorYellow"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_color_yellow"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipColorCyan"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_color_cyan"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipColorGreen"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_color_green"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Background Color Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bs_subtitle_style_bg"
                android:textColor="@color/secondary_text_color"
                android:textSize="@dimen/bs_subtitle_text_size"
                android:fontFamily="@font/open_sans_semibold"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipBgNone"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_selected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_bg_none"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipBgTranslucent"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_bg_translucent"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipBgBlack"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_bg_black"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Edge / Outline Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bs_subtitle_style_edge"
                android:textColor="@color/secondary_text_color"
                android:textSize="@dimen/bs_subtitle_text_size"
                android:fontFamily="@font/open_sans_semibold"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipEdgeOutline"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_selected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_edge_outline"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipEdgeShadow"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_edge_shadow"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipEdgeNone"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_unselected"
                    android:gravity="center"
                    android:text="@string/bs_subtitle_edge_none"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Tracks Container (if specific episode tracks are present) -->
        <LinearLayout
            android:id="@+id/subtitlesTracksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/bs_divider_color"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:text="@string/bs_subtitle_available_tracks"
                android:textColor="@color/secondary_text_color"
                android:textSize="@dimen/bs_subtitle_text_size"
                android:textStyle="bold"
                android:fontFamily="@font/open_sans_bold"/>

            <LinearLayout
                android:id="@+id/subtitlesTracksList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
