<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sort_popup"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/item_sort_asc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Хронологически"
        android:textColor="@color/primary_text_color"
        android:textSize="13.5sp"
        android:fontFamily="@font/open_sans_semibold"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/item_sort_desc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Новые сначала"
        android:textColor="@color/primary_text_color"
        android:textSize="13.5sp"
        android:fontFamily="@font/open_sans_semibold"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/item_sort_name_asc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="По названием (А-Я)"
        android:textColor="@color/primary_text_color"
        android:textSize="13.5sp"
        android:fontFamily="@font/open_sans_semibold"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/item_sort_name_desc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="По названием (Я-А)"
        android:textColor="@color/primary_text_color"
        android:textSize="13.5sp"
        android:fontFamily="@font/open_sans_semibold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
