<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Top Bar with Handle & Action Buttons -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_header"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <!-- Bottom sheet handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle" />

        <!-- Top right controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnRefreshWeb"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                app:tint="@color/primary_text_color"
                android:contentDescription="Refresh"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnCloseWeb"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/primary_text_color"
                android:contentDescription="Close"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarWeb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Content Frame -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="400dp">

        <WebView
            android:id="@+id/webViewTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Error Layout -->
        <LinearLayout
            android:id="@+id/layoutWebError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/toolbar_header_bg"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_exclamation_mark"
                app:tint="@color/gray_color"
                android:contentDescription="Error" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ошибка загрузки страницы"
                android:textColor="@color/primary_text_color"
                android:textSize="16sp"
                android:fontFamily="@font/open_sans_bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryWeb"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Повторить"
                android:textColor="@color/purple_primary"
                android:textSize="13sp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/purple_primary"
                app:strokeColor="@color/purple_primary"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
