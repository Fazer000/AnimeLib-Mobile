<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sort_popup"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Редактировать -->
    <LinearLayout
        android:id="@+id/item_comment_edit"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_edit_pencil"
            app:tint="@color/primary_text_color"
            android:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="Редактировать" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Редактировать"
            android:textColor="@color/primary_text_color"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_semibold" />
    </LinearLayout>

    <!-- Удалить -->
    <LinearLayout
        android:id="@+id/item_comment_delete"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_trash_delete"
            app:tint="#EF4444"
            android:tint="#EF4444"
            android:layout_marginEnd="10dp"
            android:contentDescription="Удалить" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Удалить"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_semibold" />
    </LinearLayout>

    <!-- Копировать -->
    <LinearLayout
        android:id="@+id/item_comment_copy"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_copy"
            app:tint="@color/primary_text_color"
            android:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="Копировать" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Копировать"
            android:textColor="@color/primary_text_color"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_semibold" />
    </LinearLayout>

    <!-- Пожаловаться -->
    <LinearLayout
        android:id="@+id/item_comment_report"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_report"
            app:tint="@color/primary_text_color"
            android:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="Пожаловаться" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пожаловаться"
            android:textColor="@color/primary_text_color"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_semibold" />
    </LinearLayout>

    <!-- Добавить в игнор лист -->
    <LinearLayout
        android:id="@+id/item_comment_ignore"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_ignore_user"
            app:tint="@color/primary_text_color"
            android:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="Добавить в игнор лист" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить в игнор лист"
            android:textColor="@color/primary_text_color"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_semibold" />
    </LinearLayout>

</LinearLayout>
