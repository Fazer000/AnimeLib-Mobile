<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                app:tint="?attr/accentTextColor"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="fitCenter"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bs_title_surround_sound"
                android:textColor="?attr/primaryTextColor"
                android:textStyle="bold"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="18sp"
                android:layout_marginStart="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="@drawable/tag_3d_background"
                android:text="3D"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                app:tint="?attr/accentTextColor"
                android:background="@drawable/button_close_background"
                android:src="@drawable/ic_close"
                android:scaleType="fitCenter"
                android:contentDescription="Close"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Main Toggle Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_m3_item_single">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_surround_sound"
                    app:tint="?attr/secondaryColor"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Объемный звук"
                        android:textColor="?attr/primaryTextColor"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Пространственная аудиосистема"
                        android:textColor="?attr/accentTextColor"
                        android:textSize="12sp"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/surroundMainSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:trackTint="@color/switch_track_tint"
                    app:thumbTint="@color/switch_thumb_tint"
                    app:showText="false"
                    android:showText="false"
                    android:textOn=""
                    android:textOff=""
                    android:checked="true"/>
            </LinearLayout>

            <!-- Container for controls when enabled -->
            <LinearLayout
                android:id="@+id/surroundControlsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- Mode Selection Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_subtitle_3d_mode"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="@dimen/bs_subtitle_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Mode Option 0: Cinema 3D -->
                <LinearLayout
                    android:id="@+id/modeCinemaOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_top"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tv"
                        app:tint="?attr/secondaryColor"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Кинотеатр 3D"
                            android:textColor="?attr/primaryTextColor"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="15.5sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Глубокая сцена, кинобас и экшен эффект"
                            android:textColor="?attr/accentTextColor"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/pillCinema"
                        android:layout_width="38dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_m3_selected_pill"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check"
                            app:tint="#FFFFFF"
                            android:contentDescription="Selected"/>
                    </FrameLayout>

                    <View
                        android:id="@+id/unselectedCinema"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Mode Option 1: Voice Focus 3D -->
                <LinearLayout
                    android:id="@+id/modeVoiceOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_voice"
                        app:tint="?attr/secondaryColor"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Четкая Озвучка 3D"
                            android:textColor="?attr/primaryTextColor"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="15.5sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Фокус на голосах сейю и дубляжа"
                            android:textColor="?attr/accentTextColor"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/pillVoice"
                        android:layout_width="38dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_m3_selected_pill"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check"
                            app:tint="#FFFFFF"
                            android:contentDescription="Selected"/>
                    </FrameLayout>

                    <View
                        android:id="@+id/unselectedVoice"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:visibility="visible"/>
                </LinearLayout>

                <!-- Mode Option 2: Concert 3D -->
                <LinearLayout
                    android:id="@+id/modeConcertOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_m3_item_bottom"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_headphones"
                        app:tint="?attr/secondaryColor"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Концерт &amp; OST 3D"
                            android:textColor="?attr/primaryTextColor"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="15.5sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Широкое стерео и чистые опенинги"
                            android:textColor="?attr/accentTextColor"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/pillConcert"
                        android:layout_width="38dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_m3_selected_pill"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check"
                            app:tint="#FFFFFF"
                            android:contentDescription="Selected"/>
                    </FrameLayout>

                    <View
                        android:id="@+id/unselectedConcert"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_m3_unselected_circle"
                        android:visibility="visible"/>
                </LinearLayout>

                <!-- Section: Fine Tuning Controls -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_subtitle_3d_width"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="@dimen/bs_subtitle_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Width Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/chipWidth0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Узкая"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipWidth1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Норма"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipWidth2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Широкая"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipWidth3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Ультра 3D"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Dialogue Boost Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_subtitle_dialogue_boost"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="@dimen/bs_subtitle_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Dialogue Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/chipDialogue0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Обычная"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipDialogue1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Четкая"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipDialogue2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Усиленная"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipDialogue3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Максимум"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Bass Boost Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_subtitle_bass_boost"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="@dimen/bs_subtitle_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Bass Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/chipBass0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Мягкий"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipBass1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Кинотеатр"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipBass2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Мощный"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipBass3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Экстрим"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Mid-Range Boost Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Средние частоты (Теплота &amp; SFX)"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="@dimen/bs_subtitle_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Mid Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/chipMids0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Мягкие"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipMids1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Норма"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipMids2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Плотные"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipMids3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Максимум"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Treble / Air Boost Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bs_subtitle_treble_boost"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="@dimen/bs_subtitle_text_size"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:layout_marginBottom="6dp"/>

                <!-- Treble Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipTreble0"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Мягкие"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipTreble1"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_selected"
                        android:gravity="center"
                        android:text="Чистые"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipTreble2"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Звонкие"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipTreble3"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/chip_unselected"
                        android:gravity="center"
                        android:text="Ультра Air"
                        android:textColor="@color/primary_text_color"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:clickable="true"
                        android:focusable="true"/>
