<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:background="?attr/statusBarColor"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:id="@+id/mainContentLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fitsSystemWindows="true" />

                <FrameLayout
                    android:id="@+id/bookmarksBarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <include layout="@layout/view_bookmarks_bar" />

                </FrameLayout>

            </LinearLayout>

            <include
                android:id="@+id/webErrorLayout"
                layout="@layout/view_web_error" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/webProgressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:indeterminate="false"
                android:max="100"
                android:visibility="gone"
                app:indicatorColor="?attr/secondaryColor"
                app:trackColor="@android:color/transparent"
                app:trackCornerRadius="2dp"
                app:trackThickness="2.5dp" />

            <include
                layout="@layout/view_url_top_banner" />

            <FrameLayout
                android:id="@+id/spinnerBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true"
                android:background="?attr/alphaPrimaryColor"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/spinner"
                    style="@style/CustomProgressIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fitsSystemWindows="true"
                    app:trackCornerRadius="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/fullscreenContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true"
                android:visibility="gone" />

            <!-- Fragment container for search and other overlays -->
            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Initial App Launch WebView Splash Screen Overlay -->
    <FrameLayout
        android:id="@+id/webSplashScreenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bs_bg_color"
        android:clickable="true"
        android:focusable="true"
        android:elevation="64dp"
        android:visibility="visible">

        <FrameLayout
            android:id="@+id/webSplashContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.example.animelib.ui.PlayerSplashLogoView
                android:id="@+id/webSplashLogoView"
                android:layout_width="98dp"
                android:layout_height="98dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/webSplashStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="74dp"
                android:alpha="0"
                android:fontFamily="@font/open_sans_semibold"
                android:letterSpacing="0.02"
                android:text="@string/web_splash_loading_hint"
                android:textColor="@color/secondary_text_color"
                android:textSize="12.5sp"
                android:visibility="invisible" />

        </FrameLayout>

    </FrameLayout>

</FrameLayout>