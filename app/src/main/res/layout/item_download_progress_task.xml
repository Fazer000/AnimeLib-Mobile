<?xml version="1.0" encoding="utf-8"?>
<com.example.animelib.ui.BorderProgressCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/dialog_card_bg"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/itemContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="9dp">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Серия 1"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans_bold"
            android:textColor="@color/primary_text_color"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="0%"
            android:textSize="11.5sp"
            android:fontFamily="@font/open_sans_semibold"
            android:textColor="@color/accent_text_color"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvEpisodeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:fontFamily="@font/open_sans"
            android:textColor="@color/secondary_text_color"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

</com.example.animelib.ui.BorderProgressCardView>
