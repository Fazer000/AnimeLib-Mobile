<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bottom_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Title Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bs_title_settings"
                    android:textColor="@color/primary_text_color"
                    android:textStyle="bold"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="@dimen/bs_title_text_size"/>

                <ImageButton
                    android:id="@+id/bs_exit"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/button_close_background"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    app:tint="@color/accent_text_color"
                    android:layout_gravity="end"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- GROUP 1: Основное -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Основное"
                android:textColor="@color/primary_text_color"
                android:textSize="14.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Quality -->
                <LinearLayout
                    android:id="@+id/qualityOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_top"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_quality"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Качество"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/currentQualityText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_text_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans"
                        android:text="1080p"/>

                    <TextView
                        android:id="@+id/currentQualityTagText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:background="@drawable/tag_fhd_background"
                        android:text="FHD"
                        android:textStyle="bold"
                        android:textSize="9.5sp"
                        android:textColor="#FFFFFF"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- 2. Video Server -->
                <LinearLayout
                    android:id="@+id/videoServerOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_server"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Сервер видео"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/currentVideoServerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_text_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans"
                        android:text="Основной"/>
                </LinearLayout>

                <!-- 3. Speed -->
                <LinearLayout
                    android:id="@+id/speedOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_speed"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Скорость"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/currentSpeedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_text_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans"
                        android:text="1.0x"/>
                </LinearLayout>

                <!-- 4. Screen Fit / Resize Mode -->
                <LinearLayout
                    android:id="@+id/resizeModeOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_bottom"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_resize_mode_fit"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Заполнение экрана"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/currentResizeModeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_text_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans"
                        android:text="По умолчанию"/>
                </LinearLayout>
            </LinearLayout>

            <!-- GROUP 2: Дополнительно -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дополнительно"
                android:textColor="@color/primary_text_color"
                android:textSize="14.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Subtitles -->
                <LinearLayout
                    android:id="@+id/subtitlesOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_top"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_subtitles"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Субтитры"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/currentSubtitleTagText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1.5dp"
                        android:background="@drawable/tag_fhd_background"
                        android:text="ASS"
                        android:textStyle="bold"
                        android:textSize="9.5sp"
                        android:textColor="#FFFFFF"
                        android:visibility="gone"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/subtitlesSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        app:trackTint="@color/switch_track_tint"
                        app:thumbTint="@color/switch_thumb_tint"
                        android:checked="true"/>
                </LinearLayout>

                <!-- 2. Ambient Light -->
                <LinearLayout
                    android:id="@+id/ambientLightOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_light"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ambient подсветка"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/ambientLightSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        app:trackTint="@color/switch_track_tint"
                        app:thumbTint="@color/switch_thumb_tint"
                        android:checked="true"/>
                </LinearLayout>

                <!-- 3. AutoPlay -->
                <LinearLayout
                    android:id="@+id/autoPlayOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_play"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Автовоспроизведение"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/autoPlaySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        app:trackTint="@color/switch_track_tint"
                        app:thumbTint="@color/switch_thumb_tint"
                        android:checked="true"/>
                </LinearLayout>

                <!-- 4. Surround Sound -->
                <LinearLayout
                    android:id="@+id/surroundSoundOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_surround_sound"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Объемный звук"
                                android:textColor="@color/primary_text_color"
                                android:textSize="15.5sp"
                                android:fontFamily="@font/open_sans_bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:paddingHorizontal="5dp"
                                android:paddingVertical="1dp"
                                android:background="@drawable/tag_3d_background"
                                android:text="3D"
                                android:textColor="#FFFFFF"
                                android:textSize="9.5sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/currentSurroundSoundText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="🎬 Кинотеатр 3D"
                            android:textColor="@color/accent_text_color"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/surroundSoundSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        app:trackTint="@color/switch_track_tint"
                        app:thumbTint="@color/switch_thumb_tint"
                        android:checked="false"/>
                </LinearLayout>

                <!-- 5. 4K Video -->
                <LinearLayout
                    android:id="@+id/fourKOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_4k"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4K видео"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/fourKSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        app:trackTint="@color/switch_track_tint"
                        app:thumbTint="@color/switch_thumb_tint"
                        android:checked="false"/>
                </LinearLayout>

                <!-- 6. Video Filters -->
                <LinearLayout
                    android:id="@+id/videoFiltersOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_tune_sliders"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Фильтры"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/currentVideoFiltersText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_text_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans"
                        android:text="По умолчанию"/>
                </LinearLayout>

                <!-- 7. Skip Duration -->
                <LinearLayout
                    android:id="@+id/skipDurationOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_bottom"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_skip"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Пропуск опенинга"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/currentSkipDurationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_text_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans"
                        android:text="1:25"/>
                </LinearLayout>
            </LinearLayout>

            <!-- GROUP 3: Прочее -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Прочее"
                android:textColor="@color/primary_text_color"
                android:textSize="14.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Theme -->
                <LinearLayout
                    android:id="@+id/themeOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_top"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:id="@+id/ivTheme"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_theme"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Тема"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <TextView
                        android:id="@+id/currentThemeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_text_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans"
                        android:text="Авто"/>
                </LinearLayout>

                <!-- 2. FAQ & Help -->
                <LinearLayout
                    android:id="@+id/faqOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_faq"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FAQ и справка"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/accent_text_color"/>
                </LinearLayout>

                <!-- 3. Bug Report (GitHub) -->
                <LinearLayout
                    android:id="@+id/bugReportOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_middle"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="3dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_bug_report"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Сообщить об ошибке"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/accent_text_color"/>
                </LinearLayout>

                <!-- 3. Check for Updates -->
                <LinearLayout
                    android:id="@+id/checkForUpdatesOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_m3_item_bottom"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:id="@+id/ivUpdateIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/primary_text_color"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Проверить обновления"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15.5sp"
                        android:fontFamily="@font/open_sans_bold"/>

                    <ProgressBar
                        android:id="@+id/updateProgressBar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/accent_text_color"
                        android:visibility="gone"/>

                    <ImageView
                        android:id="@+id/ivUpdateArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/accent_text_color"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/appVersionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:textColor="@color/secondary_text_color"
                android:textSize="13sp"
                android:text="Версия v1.8.7" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
